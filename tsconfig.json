{
  "//": "SAMPL-2-24 — npm run typecheck가 실제로 검사하게 만드는 설정.",
  "//2": "이 파일이 없으면 `tsc --noEmit`이 도움말만 출력하고 exit 0 하는 위장 게이트가 된다.",
  "//3": "checkJs는 false다. 전역 window.* 패턴 코드베이스라 true로 켜면 오류 2654건이 나와",
  "//4": "게이트로 쓸 수 없다(실측). 대신 `// @ts-check`를 붙인 파일만 검사한다 —",
  "//5": "새 코드·수정 파일에 한 줄 추가하면 게이트 범위가 점진적으로 넓어진다.",

  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "strict": true,
    "noImplicitAny": false,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"],

    // vitest.config.js:11의 @shared alias와 짝을 맞춘다.
    // 없으면 tests/unit에서 @shared를 쓰면서 @ts-check를 붙일 때 TS2307이 난다.
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"] }
  },

  // 확장자를 좁혀두면 나중에 .ts/.mjs 파일을 추가할 때 @ts-check를 붙여도
  // 프로그램에 안 들어가 조용히 무시된다 — 원래 위장 게이트와 같은 실패 양식이다.
  "include": [
    "src/**/*.{js,mjs,cjs,ts,mts,cts}",
    "scripts/**/*.{js,mjs,cjs,ts}",
    "tests/**/*.{js,mjs,cjs,ts}",
    "types/**/*.d.ts",
    "forge.config.js",
    "vite.config.js",
    "vitest.config.js",
    "playwright.config.js"
  ],

  "exclude": [
    "node_modules",
    "docs",
    "out",
    "playwright-report",
    "test-results"
  ]
}
